---
const { title = "Hoss — AI & Software", description = "Technical portfolio covering artificial intelligence, image and signal processing, data analysis, and software development." } = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d10" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://h02s.github.io" />
    <link rel="canonical" href="https://h02s.github.io" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Home"><span class="brand-mark">H</span><span>h02s<span class="brand-dot">.</span></span></a>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a><a href="/#research">Research</a><a href="/articles">Notes</a>
      </nav>
      <a class="header-github" href="https://github.com/h02s" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <a class="footer-brand" href="/">h02s<span>.</span></a>
      <span>Built with Astro · Deployed on GitHub Pages</span>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800&family=Vazirmatn:wght@400;500;600;700&display=swap');
:root{color-scheme:dark;--bg:#090b0e;--surface:#101419;--surface2:#151b22;--text:#edf1f5;--muted:#929ca8;--soft:#bac3cd;--line:#252d36;--accent:#b4f36b;--accent-dim:#202d18;--max:1120px}
:root[data-theme="light"]{color-scheme:light;--bg:#f7f8f6;--surface:#fff;--surface2:#eef1eb;--text:#141914;--muted:#657064;--soft:#455044;--line:#dfe5da;--accent:#4f861e;--accent-dim:#e9f2df}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--bg);color:var(--text);font-family:"DM Sans",Vazirmatn,sans-serif;line-height:1.7;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
::selection{background:var(--accent);color:#10150c}
.noise{position:fixed;inset:0;pointer-events:none;z-index:5;opacity:.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
.site-header{height:76px;max-width:var(--max);margin:auto;padding:0 26px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:relative;z-index:10}
.brand{display:flex;gap:11px;align-items:center;font-weight:800;font-size:17px;letter-spacing:-.05em}.brand-mark{width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--line);border-radius:10px;background:var(--surface2);color:var(--accent);font-size:15px}.brand-dot,.footer-brand span{color:var(--accent)}
nav{display:flex;gap:32px;color:var(--muted);font-size:13px;font-weight:600}nav a:hover,.text-link:hover,.hero-links a:hover{color:var(--accent)}
.header-github{font-size:12px;font-weight:700;border:1px solid var(--line);border-radius:8px;padding:7px 12px;background:var(--surface)}.header-github span{color:var(--accent);margin-left:4px}
.container{max-width:var(--max);margin:auto;padding:0 26px}
.eyebrow{font:500 10px/1.5 "DM Mono",monospace;letter-spacing:.15em;color:var(--accent);text-transform:uppercase}
.status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--accent);margin-right:9px;box-shadow:0 0 12px #b4f36b70}
.hero{min-height:620px;display:grid;align-items:center;grid-template-columns:1.12fr .88fr;gap:72px;padding:76px 0 85px}
.hero h1{font-size:clamp(48px,6.2vw,76px);line-height:1.06;letter-spacing:-.075em;margin:23px 0 25px;font-weight:800}.hero h1 span{color:var(--muted)}
.hero-lead{font-size:16px;line-height:1.9;color:var(--muted);max-width:570px;margin:0}
.actions{display:flex;gap:11px;margin-top:29px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:12px;padding:11px 16px;border:1px solid var(--line);border-radius:8px;font-size:12px;font-weight:700;background:var(--surface);transition:transform .2s,border-color .2s,background .2s}
.btn:hover{transform:translateY(-2px);border-color:var(--accent)}
.btn.primary{background:var(--accent);color:#11170c;border-color:var(--accent)}.btn.primary:hover{background:#c7fa8a}
.hero-links{display:flex;align-items:center;gap:19px;flex-wrap:wrap;margin-top:35px;font:10px "DM Mono",monospace;color:var(--muted)}.hero-links span{width:100%;color:var(--muted);opacity:.75}
.hero-panel{border:1px solid var(--line);border-radius:13px;background:linear-gradient(145deg,var(--surface),#0c1014);padding:25px;position:relative;overflow:hidden}
:root[data-theme="light"] .hero-panel{background:linear-gradient(145deg,#fff,#f1f4ed)}
.hero-panel:after{content:"";position:absolute;width:230px;height:230px;border:1px solid var(--line);border-radius:50%;right:-120px;top:-120px;box-shadow:0 0 0 25px var(--bg),0 0 0 26px var(--line),0 0 0 52px var(--bg),0 0 0 53px var(--line);opacity:.45}
.panel-top{display:flex;justify-content:space-between;align-items:center;padding-bottom:22px;border-bottom:1px solid var(--line)}
.panel-label{font:10px "DM Mono",monospace;color:var(--muted);letter-spacing:.13em}.panel-mark{font-size:23px;font-weight:800;color:var(--accent);letter-spacing:-.08em}
.focus-list{padding:10px 0}.focus-item{display:flex;gap:17px;align-items:center;padding:17px 0;border-bottom:1px solid var(--line)}.focus-index{font:11px "DM Mono",monospace;color:var(--accent)}.focus-item strong,.focus-item small{display:block}.focus-item strong{font-size:13px;font-weight:700}.focus-item small{font-size:11px;color:var(--muted);margin-top:3px}
.panel-foot{display:flex;justify-content:space-between;padding-top:17px;font:9px "DM Mono",monospace;letter-spacing:.08em;color:var(--muted)}
.intro-strip{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:45px 0;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.intro-strip h2,.section-head h2,.closing-cta h2,.about-bottom h2{font-size:clamp(25px,3vw,34px);letter-spacing:-.055em;line-height:1.2;margin:10px 0 0}
.intro-strip p{color:var(--muted);font-size:14px;line-height:1.9;margin:0;max-width:510px}
.section-block{padding:88px 0 0}
.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:25px}.section-head h2{margin-top:9px}
.text-link{font-size:11px;font-weight:700;color:var(--muted);white-space:nowrap}
.project-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:13px}
.project-card{min-height:255px;padding:22px;border:1px solid var(--line);border-radius:11px;background:var(--surface);display:flex;flex-direction:column;justify-content:space-between;transition:transform .2s,border-color .2s,background .2s}
.project-card:hover{transform:translateY(-4px);border-color:#71845b;background:var(--surface2)}
.project-card.featured{background:linear-gradient(145deg,var(--surface),var(--accent-dim))}
.project-top{display:flex;justify-content:space-between;align-items:center}.project-type{font:9px "DM Mono",monospace;letter-spacing:.1em;color:var(--accent)}.project-arrow{font:10px "DM Mono",monospace;color:var(--muted)}
.project-card h3{font-size:21px;letter-spacing:-.05em;margin:12px 0 8px}.project-card p{font-size:12px;color:var(--muted);line-height:1.8;margin:0}
.project-tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:22px}.project-tags span{font:9px "DM Mono",monospace;color:var(--soft);border:1px solid var(--line);border-radius:5px;padding:4px 7px}
.toolkit{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface)}
.toolkit>div{padding:21px;border-right:1px solid var(--line)}.toolkit>div:last-child{border:0}.toolkit-label{font:9px "DM Mono",monospace;color:var(--accent);letter-spacing:.1em}.toolkit p{font-size:12px;color:var(--soft);line-height:1.9;margin:12px 0 0}
.writing-list{border-top:1px solid var(--line)}.writing-item{display:grid;grid-template-columns:150px 1fr 20px;gap:20px;align-items:center;padding:17px 4px;border-bottom:1px solid var(--line);transition:color .2s}.writing-item:hover{color:var(--accent)}.writing-category{font:9px "DM Mono",monospace;color:var(--muted);text-transform:uppercase}.writing-title{font-size:13px;font-weight:600}.writing-arrow{color:var(--accent);text-align:right}
.closing-cta{margin:90px 0 15px;padding:31px;border:1px solid var(--line);border-radius:12px;background:var(--surface);display:flex;justify-content:space-between;align-items:center;gap:25px}.closing-cta p{color:var(--muted);font-size:12px;margin:10px 0 0}
.site-footer{max-width:var(--max);margin:80px auto 0;padding:24px 26px 30px;display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);color:var(--muted);font:10px "DM Mono",monospace}.footer-brand{font:800 15px "DM Sans",sans-serif;color:var(--text);letter-spacing:-.05em}
.about-hero{padding:100px 0 65px;max-width:820px}.about-hero h1{font-size:clamp(55px,8vw,86px);letter-spacing:-.08em;line-height:1;margin:19px 0 24px}.accent-period{color:var(--accent)}.about-lead{font-size:20px;line-height:1.75;color:var(--muted);max-width:760px}.about-actions{display:flex;gap:10px;margin-top:27px}
.about-content-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:75px;padding:55px 0 75px;border-top:1px solid var(--line)}
.about-main h2{font-size:30px;line-height:1.2;letter-spacing:-.06em;margin:15px 0 23px}.about-main p{font-size:14px;line-height:2;color:var(--muted);margin:0 0 17px}
.about-side{display:grid;gap:12px}.about-box{padding:20px;border:1px solid var(--line);border-radius:10px;background:var(--surface)}.about-box h3{font-size:15px;margin:11px 0 5px}.about-box p,.about-box li{font-size:12px;color:var(--muted);line-height:1.9}.about-box ul{padding-left:17px;margin:10px 0 0}.about-bottom{padding:34px 0 15px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:end;gap:20px}
.article{max-width:780px;margin:80px auto}.article h1{font-size:clamp(40px,6vw,68px);line-height:1.05;letter-spacing:-.055em;margin:15px 0}.article .lead{font-size:19px;color:var(--muted)}.article-content{margin-top:55px;font-size:17px}.article-content h2{margin-top:50px}.article-content a{color:var(--accent);text-decoration:underline}.article-content pre{overflow:auto;background:#080a0d;border:1px solid var(--line);padding:18px;border-radius:12px}.article-content code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9em}.article-content :not(pre)>code{background:var(--surface2);padding:2px 5px;border-radius:5px}.back{color:var(--muted);font-size:13px}.date{color:var(--muted);font-size:13px}
@media(max-width:850px){.hero{grid-template-columns:1fr;gap:40px;min-height:auto;padding:75px 0}.hero-panel{max-width:620px}.project-grid{grid-template-columns:1fr 1fr}.project-card.featured{grid-column:span 2}.toolkit{grid-template-columns:1fr 1fr}.toolkit>div:nth-child(2){border-right:0}.toolkit>div:nth-child(-n+2){border-bottom:1px solid var(--line)}.about-content-grid{gap:35px}}
@media(max-width:600px){.site-header{height:66px;padding:0 18px}nav{display:none}.container{padding:0 19px}.hero{padding:65px 0 55px}.hero h1{font-size:clamp(43px,12vw,60px)}.hero-lead{font-size:14px}.hero-panel{padding:19px}.intro-strip{grid-template-columns:1fr;gap:15px;padding:32px 0}.section-block{padding-top:65px}.section-head{align-items:start;gap:12px}.section-head h2{font-size:26px}.project-grid{grid-template-columns:1fr}.project-card.featured{grid-column:auto}.project-card{min-height:215px}.toolkit{grid-template-columns:1fr 1fr}.toolkit>div{padding:15px}.writing-item{grid-template-columns:1fr 20px;gap:4px}.writing-category{grid-column:1}.writing-title{grid-column:1}.writing-arrow{grid-column:2;grid-row:1/3}.closing-cta{margin-top:65px;padding:22px;align-items:flex-start;flex-direction:column}.site-footer{margin-top:60px;padding:22px 19px;align-items:flex-start;flex-direction:column;gap:9px}.about-hero{padding:75px 0 45px}.about-lead{font-size:16px}.about-content-grid{grid-template-columns:1fr;padding:40px 0 55px;gap:30px}.about-main h2{font-size:26px}.about-bottom{align-items:flex-start;flex-direction:column}.about-bottom h2{font-size:26px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
</style>