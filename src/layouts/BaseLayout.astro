---
const { title = "Hoss — Software Developer", description = "Personal website, notes, projects and technical writing." } = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d10" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="noise"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Hoss home">
        <span class="brand-mark">H</span>
        <span>h02s</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#writing">Writing</a>
        <a href="/#projects">Projects</a>
        <a href="/about">About</a>
      </nav>
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">◐</button>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} h02s</span>
      <span>Built with Astro · Deployed on GitHub Pages</span>
    </footer>
    <script is:inline>
      const btn = document.getElementById("themeToggle");
      const saved = localStorage.getItem("theme");
      if (saved) document.documentElement.dataset.theme = saved;
      btn?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Vazirmatn:wght@400;500;600;700&display=swap');
:root{--bg:#0b0d10;--surface:#11151a;--surface2:#171c22;--text:#eef2f6;--muted:#929aa6;--line:#252b33;--accent:#9cff57;--max:1120px}
:root[data-theme="light"]{--bg:#f6f7f8;--surface:#fff;--surface2:#eef0f2;--text:#101318;--muted:#616974;--line:#dfe3e8;--accent:#4d8f16}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,Vazirmatn,sans-serif;line-height:1.65}a{color:inherit;text-decoration:none}.noise{position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}.site-header{height:72px;max-width:var(--max);margin:auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;gap:10px;align-items:center;font-weight:800;letter-spacing:-.03em}.brand-mark{width:31px;height:31px;display:grid;place-items:center;border:1px solid var(--line);border-radius:9px;background:var(--surface2);color:var(--accent)}nav{display:flex;gap:28px;color:var(--muted);font-size:14px}nav a:hover{color:var(--text)}.theme-toggle{border:1px solid var(--line);background:var(--surface);color:var(--text);border-radius:9px;width:34px;height:34px;cursor:pointer}.site-footer{max-width:var(--max);margin:90px auto 0;padding:24px;display:flex;justify-content:space-between;border-top:1px solid var(--line);color:var(--muted);font-size:12px}.container{max-width:var(--max);margin:auto;padding:0 24px}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.16em;color:var(--accent);font-weight:700}.hero{min-height:620px;display:grid;align-items:center;grid-template-columns:1.25fr .75fr;gap:60px}.hero h1{font-size:clamp(52px,8vw,94px);line-height:.98;letter-spacing:-.07em;margin:18px 0 26px;max-width:850px}.hero h1 span{color:var(--muted)}.hero p{font-size:18px;color:var(--muted);max-width:650px}.actions{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}.btn{padding:11px 17px;border:1px solid var(--line);border-radius:10px;font-size:14px;font-weight:600;background:var(--surface)}.btn.primary{background:var(--accent);color:#10140d;border-color:var(--accent)}.hero-card{border:1px solid var(--line);background:linear-gradient(145deg,var(--surface),transparent);border-radius:18px;padding:22px}.terminal{font:13px/1.8 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted)}.terminal strong{color:var(--text)}section{padding:80px 0}.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:26px}.section-head h2{margin:0;font-size:30px;letter-spacing:-.04em}.section-head a{color:var(--muted);font-size:13px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.card{border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:22px;transition:transform .2s,border-color .2s}.card:hover{transform:translateY(-3px);border-color:#46505c}.card .meta{font-size:11px;color:var(--accent);text-transform:uppercase;letter-spacing:.1em}.card h3{margin:12px 0 8px;font-size:19px;letter-spacing:-.03em}.card p{color:var(--muted);font-size:14px;margin:0}.tags{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}.tag{font-size:11px;color:var(--muted);background:var(--surface2);padding:4px 8px;border-radius:6px}.project{min-height:190px;display:flex;flex-direction:column;justify-content:space-between}.project .num{color:var(--muted);font:12px ui-monospace,monospace}.split{display:grid;grid-template-columns:1fr 1fr;gap:14px}.about-box{padding:30px;border:1px solid var(--line);border-radius:15px;background:var(--surface)}.about-box p{color:var(--muted)}.article{max-width:780px;margin:80px auto}.article h1{font-size:clamp(40px,6vw,68px);line-height:1.05;letter-spacing:-.055em;margin:15px 0}.article .lead{font-size:19px;color:var(--muted)}.article-content{margin-top:55px;font-size:17px}.article-content h2{margin-top:50px}.article-content a{color:var(--accent);text-decoration:underline}.article-content pre{overflow:auto;background:#080a0d;border:1px solid var(--line);padding:18px;border-radius:12px}.article-content code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9em}.article-content :not(pre)>code{background:var(--surface2);padding:2px 5px;border-radius:5px}.back{color:var(--muted);font-size:13px}.date{color:var(--muted);font-size:13px}.profile{max-width:760px;padding:90px 0}.profile h1{font-size:60px;letter-spacing:-.06em}.profile p{color:var(--muted);font-size:17px}.socials{display:flex;gap:18px;margin-top:25px;color:var(--muted);font-size:14px}@media(max-width:800px){nav{display:none}.hero{grid-template-columns:1fr;min-height:auto;padding:85px 0 40px}.hero-card{display:none}.grid,.split{grid-template-columns:1fr}.site-footer{flex-direction:column;gap:8px}.hero h1{font-size:58px}}
</style>