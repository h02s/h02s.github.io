---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const articles = (await getCollection("articles", ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Articles — h02s">
  <div class="container">
    <section>
      <div class="eyebrow">Writing</div>
      <h1 style="font-size:56px;letter-spacing:-.06em">Articles & notes</h1>
      <p style="color:var(--muted);max-width:650px">Short, practical write-ups about software, infrastructure and things I’m learning.</p>
      <div style="margin-top:40px" class="grid">
        {articles.map((article) => (
          <a class="card" href={`/articles/${article.id}/`}>
            <div class="meta">{article.data.category} · {article.data.date.toLocaleDateString("en-US",{year:"numeric",month:"short",day:"numeric"})}</div>
            <h3>{article.data.title}</h3><p>{article.data.description}</p>
            <div class="tags">{article.data.tags.map(tag=><span class="tag">{tag}</span>)}</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>