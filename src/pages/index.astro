---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="Hoss — AI, Image Processing & Software Engineering"
  description="Technical portfolio covering artificial intelligence, computer vision, image and signal processing, data analysis, and software development."
>
  <div class="container">
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> AI · Image Processing · Software</div>
        <h1>Research with purpose.<br /><span>Engineering through practice.</span></h1>
        <p class="hero-lead">
          I explore artificial intelligence and software systems through implementation,
          experimentation, and careful evaluation. My interests connect computer vision,
          image and signal processing, data analytics, and intelligent applications.
        </p>
        <div class="actions">
          <a class="btn primary" href="#work">Selected work <span aria-hidden="true">↗</span></a>
          <a class="btn" href="#research">Research interests</a>
        </div>
        <div class="hero-links">
          <a href="https://github.com/h02s" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="mailto:contact@hdfmy.ir">Email ↗</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Research and technical focus">
        <div class="panel-top"><span class="panel-label">AREAS OF FOCUS</span><span class="panel-mark">H.</span></div>
        <div class="focus-list">
          <div class="focus-item"><span class="focus-index">01</span><div><strong>Computer Vision & Imaging</strong><small>Image analysis · Biomedical imaging</small></div></div>
          <div class="focus-item"><span class="focus-index">02</span><div><strong>Machine Learning & AI</strong><small>Model evaluation · Intelligent systems</small></div></div>
          <div class="focus-item"><span class="focus-index">03</span><div><strong>Data & Signal Processing</strong><small>Financial analytics · FFT / STFT</small></div></div>
          <div class="focus-item"><span class="focus-index">04</span><div><strong>Efficient AI Systems</strong><small>Local inference · Resource-aware computing</small></div></div>
        </div>
        <div class="panel-foot"><span>STUDY</span><span>IMPLEMENT</span><span>EVALUATE</span><span>REFINE</span></div>
      </aside>
    </section>

    <section class="intro-strip">
      <div><span class="eyebrow">TECHNICAL APPROACH</span><h2>From concepts to reproducible experiments.</h2></div>
      <p>I value strong foundations, thoughtful implementation, and honest evaluation. I enjoy exploring a problem, building a practical solution, measuring its behavior, and documenting the results.</p>
    </section>

    <section id="work" class="section-block">
      <div class="section-head">
        <div><div class="eyebrow">IMPLEMENTATION & EXPERIMENTS</div><h2>Selected technical work</h2></div>
      </div>
      <div class="project-grid">
        <article class="project-card featured">
          <div class="project-top"><span class="project-type">WEB APPLICATION</span><span class="project-arrow">01</span></div>
          <div><h3>Django Application Development</h3><p>Developed an e-commerce web application with server-side structure and core application logic. Also worked with OTP authentication, API integration, S3-compatible storage, and Celery background tasks.</p></div>
          <div class="project-tags"><span>Python</span><span>Django</span><span>REST APIs</span><span>Celery</span></div>
        </article>
        <article class="project-card">
          <div class="project-top"><span class="project-type">SIGNAL PROCESSING</span><span class="project-arrow">02</span></div>
          <div><h3>Speech Denoising</h3><p>Prepared speech audio, examined time-frequency representations using STFT, and compared denoising outputs across selected noisy intervals.</p></div>
          <div class="project-tags"><span>FFT</span><span>STFT</span><span>SciPy</span></div>
        </article>
        <article class="project-card">
          <div class="project-top"><span class="project-type">PERSIAN SPEECH AI</span><span class="project-arrow">03</span></div>
          <div><h3>ASR & Text-to-Speech</h3><p>Set up local inference for a Persian TTS model and explored Persian automatic speech recognition models and workflows.</p></div>
          <div class="project-tags"><span>ASR</span><span>TTS</span><span>Hugging Face</span></div>
        </article>
        <article class="project-card">
          <div class="project-top"><span class="project-type">LOCAL AI</span><span class="project-arrow">04</span></div>
          <div><h3>Local Model Experiments</h3><p>Ran and explored local language models and model formats, including Qwen and Gemma GGUF resources, with local inference tools.</p></div>
          <div class="project-tags"><span>Ollama</span><span>GGUF</span><span>LLMs</span></div>
        </article>
      </div>
    </section>

    <section id="research" class="section-block">
      <div class="section-head">
        <div><div class="eyebrow">RESEARCH DIRECTIONS</div><h2>Questions worth exploring</h2></div>
      </div>
      <div class="toolkit">
        <div><span class="toolkit-label">VISION & IMAGING</span><p>Computer vision · Image processing · Medical AI · Biomedical image analysis</p></div>
        <div><span class="toolkit-label">SPATIAL & FINANCIAL DATA</span><p>Geospatial AI · Remote sensing · Financial data analytics</p></div>
        <div><span class="toolkit-label">INTELLIGENT SYSTEMS</span><p>Multimodal AI · LLMs · RAG · Intelligent agents · Object tracking</p></div>
        <div><span class="toolkit-label">EFFICIENT COMPUTING</span><p>Efficient and green AI · Local inference · Resource-aware methods</p></div>
      </div>
    </section>

    <section class="section-block">
      <div class="section-head">
        <div><div class="eyebrow">TECHNICAL TOOLKIT</div><h2>Tools & technologies</h2></div>
      </div>
      <div class="toolkit">
        <div><span class="toolkit-label">PROGRAMMING</span><p>Python · PHP · SQL · Django · REST APIs · FastAPI (familiarity)</p></div>
        <div><span class="toolkit-label">SCIENTIFIC COMPUTING</span><p>NumPy · Pandas · SciPy · scikit-learn · Matplotlib · Seaborn · Jupyter</p></div>
        <div><span class="toolkit-label">AI & DATA</span><p>PyTorch · OpenCV · Hugging Face · Transformers · RAG · LangChain / LangGraph (familiarity)</p></div>
        <div><span class="toolkit-label">SYSTEMS & TOOLS</span><p>Debian Linux · Git · Docker · Incus/LXC · Ollama · n8n · MCP</p></div>
      </div>
    </section>

    <section class="section-block">
      <div class="section-head">
        <div><div class="eyebrow">INDEPENDENT STUDY</div><h2>Financial markets & data</h2></div>
      </div>
      <p class="hero-lead" style="max-width:850px;font-size:14px">Alongside technical interests, I independently follow blockchain and cryptocurrency markets, Iran's stock market, and U.S. equity markets, including the Nasdaq and S&P 500. This is personal market research and learning, not professional employment or investment-advisory experience.</p>
    </section>

    {articles.length > 0 && (
      <section id="writing" class="section-block">
        <div class="section-head">
          <div><div class="eyebrow">TECHNICAL NOTES</div><h2>Writing & explanations</h2></div>
          <a class="text-link" href="/articles">All notes ↗</a>
        </div>
        <div class="writing-list">
          {articles.slice(0, 3).map((article) => (
            <a class="writing-item" href={`/articles/${article.id}/`}>
              <span class="writing-category">{article.data.category}</span>
              <span class="writing-title">{article.data.title}</span>
              <span class="writing-arrow">↗</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="closing-cta">
      <div><div class="eyebrow">CONTACT</div><h2>Research, ideas, and engineering.</h2><p>For thoughtful discussions around AI, image processing, data, and software development.</p></div>
      <a class="btn primary" href="mailto:contact@hdfmy.ir">Get in touch ↗</a>
    </section>
  </div>
</BaseLayout>