---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="Hoss — Software Engineer & AI Graduate Student"
  description="Hoss's portfolio: software engineering, machine learning, image processing, Linux, and open-source experiments."
>
  <div class="container">
    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> Software Engineer · AI & Robotics</div>
        <h1>Building useful software.<br /><span>Exploring intelligent systems.</span></h1>
        <p class="hero-lead">
          I'm Hoss — a computer engineer and graduate student interested in artificial intelligence,
          image processing, and building reliable software from practical ideas.
        </p>
        <div class="actions">
          <a class="btn primary" href="#projects">Explore projects <span aria-hidden="true">↗</span></a>
          <a class="btn" href="/about">More about me</a>
        </div>
        <div class="hero-links">
          <a href="https://github.com/h02s" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="mailto:contact@hdfmy.ir">Email ↗</a>
          <span>Based in Iran · Open to research collaboration</span>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Current interests">
        <div class="panel-top"><span class="panel-label">CURRENT FOCUS</span><span class="panel-mark">H.</span></div>
        <div class="focus-list">
          <div class="focus-item"><span class="focus-index">01</span><div><strong>Artificial Intelligence</strong><small>Machine learning · AI systems</small></div></div>
          <div class="focus-item"><span class="focus-index">02</span><div><strong>Image Processing</strong><small>Classical methods · Computer vision</small></div></div>
          <div class="focus-item"><span class="focus-index">03</span><div><strong>Software Engineering</strong><small>Python · Django · Backend systems</small></div></div>
          <div class="focus-item"><span class="focus-index">04</span><div><strong>Linux & Open Source</strong><small>Self-hosting · Systems · Networking</small></div></div>
        </div>
        <div class="panel-foot"><span>LEARN</span><span>BUILD</span><span>MEASURE</span><span>IMPROVE</span></div>
      </aside>
    </section>

    <section class="intro-strip">
      <div><span class="eyebrow">A LITTLE ABOUT MY APPROACH</span><h2>Curiosity backed by implementation.</h2></div>
      <p>I enjoy moving beyond theory: understanding an idea, implementing it, testing the result, and documenting what I learn along the way.</p>
    </section>

    <section id="projects" class="section-block">
      <div class="section-head">
        <div><div class="eyebrow">SELECTED WORK</div><h2>Projects & experiments</h2></div>
        <a class="text-link" href="https://github.com/h02s?tab=repositories" target="_blank" rel="noreferrer">All repositories ↗</a>
      </div>
      <div class="project-grid">
        <a class="project-card featured" href="https://github.com/h02s/colibri" target="_blank" rel="noreferrer">
          <div class="project-top"><span class="project-type">SYSTEMS · OPEN SOURCE</span><span class="project-arrow">↗</span></div>
          <div><h3>Colibrì</h3><p>A C-based local inference engine exploring how large mixture-of-experts models can run across GPU memory, system RAM, and storage.</p></div>
          <div class="project-tags"><span>C</span><span>Systems</span><span>AI Infrastructure</span></div>
        </a>
        <a class="project-card" href="https://github.com/h02s" target="_blank" rel="noreferrer">
          <div class="project-top"><span class="project-type">ENGINEERING NOTEBOOK</span><span class="project-arrow">↗</span></div>
          <div><h3>Practical experiments</h3><p>Small implementations and technical explorations across Python, signal processing, Linux, and software development.</p></div>
          <div class="project-tags"><span>Python</span><span>DSP</span><span>Linux</span></div>
        </a>
        <a class="project-card" href="/articles">
          <div class="project-top"><span class="project-type">TECHNICAL WRITING</span><span class="project-arrow">↗</span></div>
          <div><h3>Notes & explanations</h3><p>Clear, practical notes about concepts, tools, experiments, and lessons learned while building.</p></div>
          <div class="project-tags"><span>Learning</span><span>Documentation</span></div>
        </a>
      </div>
    </section>

    <section class="section-block">
      <div class="section-head">
        <div><div class="eyebrow">TOOLKIT</div><h2>Technologies I work with</h2></div>
      </div>
      <div class="toolkit">
        <div><span class="toolkit-label">LANGUAGES</span><p>Python · PHP · C · JavaScript · SQL</p></div>
        <div><span class="toolkit-label">FRAMEWORKS</span><p>Django · Laravel · Astro</p></div>
        <div><span class="toolkit-label">AI & DATA</span><p>Machine Learning · Image Processing · NumPy · OpenCV</p></div>
        <div><span class="toolkit-label">TOOLS & SYSTEMS</span><p>Linux · Git · Docker · Incus · PostgreSQL</p></div>
      </div>
    </section>

    {articles.length > 0 && (
      <section id="writing" class="section-block">
        <div class="section-head">
          <div><div class="eyebrow">FROM THE NOTEBOOK</div><h2>Latest writing</h2></div>
          <a class="text-link" href="/articles">All articles ↗</a>
        </div>
        <div class="writing-list">
          {articles.slice(0, 3).map((article) => (
            <a class="writing-item" href={\`/articles/\${article.id}/\`}>
              <span class="writing-category">{article.data.category}</span>
              <span class="writing-title">{article.data.title}</span>
              <span class="writing-arrow">↗</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="closing-cta">
      <div><div class="eyebrow">LET'S CONNECT</div><h2>Have an interesting idea?</h2><p>I'm always glad to connect about research, software, and thoughtful engineering.</p></div>
      <a class="btn primary" href="mailto:contact@hdfmy.ir">Get in touch ↗</a>
    </section>
  </div>
</BaseLayout>