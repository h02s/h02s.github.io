---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About — h02s">
  <div class="container">
    <section class="profile">
      <div class="eyebrow">About</div>
      <h1>Hi, I'm Hoss.</h1>
      <p>I’m a software developer interested in building useful things and understanding how they work underneath.</p>
      <p>This website is deliberately simple: it is my personal knowledge base, technical notebook and portfolio in one place. Instead of listing every technology I have touched, I want the projects and writing here to show how I think, learn and build.</p>
      <div class="socials">
        <a href="https://github.com/h02s" target="_blank" rel="noreferrer">GitHub</a>
        <a href="mailto:hello@example.com">Email</a>
      </div>
    </section>
    <section>
      <div class="split">
        <div class="about-box"><div class="eyebrow">Focus</div><h2>Backend & Web</h2><p>PHP, Laravel, Python, Django, APIs and practical application architecture.</p></div>
        <div class="about-box"><div class="eyebrow">Infrastructure</div><h2>Linux & Containers</h2><p>Linux, Docker, Incus, networking and self-hosted development environments.</p></div>
      </div>
    </section>
  </div>
</BaseLayout>